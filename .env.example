# Copy to .env and fill in every empty value. Never commit .env.
PROVIDER=ollama                 # ollama | gemini
MODEL=qwen2.5:7b                # e.g. gemini-2.5-flash for gemini
GEMINI_API_KEY=
GEMINI_THINKING_BUDGET=1024
OLLAMA_BASE_URL=http://localhost:11434
RETRY_DELAY_S=2.0
REQUEST_TIMEOUT_S=15            # brief requires 15; raise only for slow local models and disclose

# App database (docker compose service `appdb`, user/db `claims`, port 5433)
APP_DB_PASSWORD=
DATABASE_URL=postgresql://claims:<APP_DB_PASSWORD>@localhost:5433/claims

# Self-hosted Langfuse (docker compose). Choose your own values.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=            # any string starting pk-lf-
LANGFUSE_SECRET_KEY=            # any string starting sk-lf-
LF_ADMIN_EMAIL=
LF_ADMIN_PASSWORD=
LF_SALT=
LF_ENCRYPTION_KEY=              # openssl rand -hex 32
LF_NEXTAUTH_SECRET=             # openssl rand -base64 32
LF_DB_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
