# Copy to .env and fill in. Never commit .env.
PROVIDER=gemini                 # gemini | ollama
MODEL=gemini-2.5-flash          # or e.g. qwen2.5:7b for ollama
GEMINI_API_KEY=
GEMINI_THINKING_BUDGET=1024
OLLAMA_BASE_URL=http://localhost:11434
RETRY_DELAY_S=2.0

DATABASE_URL=postgresql://claims:claims@localhost:5433/claims

# Self-hosted Langfuse from docker-compose.yml (headless-init project keys)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local-demo
LANGFUSE_SECRET_KEY=sk-lf-local-demo
